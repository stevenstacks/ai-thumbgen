# Copy this file to .env and fill in your key in an editor (never paste it in a chat).
#   Windows:     Copy-Item .env.example .env ; notepad .env
#   macOS/Linux: cp .env.example .env && $EDITOR .env
OPENAI_API_KEY=

# Defaults (can be overridden per run with --model / --quality)
# Models: gpt-image-2 | gpt-image-2.5-flare | gpt-image-2.5-sunburst
THUMBGEN_MODEL=gpt-image-2
# Quality: low | medium | high
THUMBGEN_QUALITY=medium

# Optional: game name used in the prompt preamble, e.g. Sifu, Elden Ring
THUMBGEN_GAME=

# Optional: explicit paths if ffmpeg/ffprobe are not on PATH
# THUMBGEN_FFMPEG=C:\path\to\ffmpeg.exe
# THUMBGEN_FFPROBE=C:\path\to\ffprobe.exe
